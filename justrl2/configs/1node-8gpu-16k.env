# JustRL2 — MiniCPM5-2B, 16k-context math RL on ONE node with 8 GPUs
#
# ⚠️ 这不是 JustRL-II 配方的复现，是一个**缩短上下文**的变体。
#
# 配方的核心机制 λ_i = k^(1/L_i) 直接以响应长度 L_i 为输入（见 docs/method.md 第 3 节），
# 所以把上限从 30720 砍到 14336 会整体改变 λ 的分布 —— 同样的 k，更短的 L 给出更小的
# λ，即更强的折扣。三个核心旋钮（GAE_LAMBDA_K / CRITIC_VALUE_BIAS_INIT /
# NUM_CRITIC_ONLY_STEPS）一个没动，但它们作用的长度分布变了。用这个配置得到的曲线
# 不能直接和 32k / 128k 的结果比较。
#
# 为什么需要它：32k 配置在这台机器上跑到第 25 步后 rollout 卡死，SGLang 反复
# 「KV cache pool is full. Retract requests.」—— 回撤意味着已生成的 KV 被丢弃、
# 之后重新 prefill，做过的功白费，而且会抖动（回撤→重算→又满→再回撤）。
# 成因是 KV cache 超配（见下面的预算）。
#
#   bash run_train.sh   # 需要先 export CONFIG 指向本文件，或
#   CONFIG=justrl2/configs/1node-8gpu-16k.env bash run_train.sh

# ---- experiment ------------------------------------------------------------
# 故意与 32k 的 EXP_TAG 不同：那个 run 的 checkpoint 是在 32k 分布下训练的，
# value head 学的是「32k 分布下这个状态值多少」。在它上面接着跑 16k 会既得不到
# 干净的 32k 结果，也得不到干净的 16k 结果。必须从头开始。
: ${EXP_TAG:=justrl2_minicpm5_2b_math16k_1node}

# ---- topology: 4 actor + 4 critic on the same node ------------------------
: ${GPUS_PER_NODE:=8}
: ${ACTOR_NUM_GPUS_PER_NODE:=4}
: ${CRITIC_NUM_GPUS_PER_NODE:=4}

# ---- 16k context budget ---------------------------------------------------
: ${ROLLOUT_MAX_PROMPT_LEN:=2048}
: ${ROLLOUT_MAX_RESPONSE_LEN:=14336}   # 16k - 2k prompt
: ${ROLLOUT_MAX_CONTEXT_LEN:=16384}
: ${OVERLONG_BUFFER_LEN:=2867}         # 响应长度的 20%（DAPO soft overlong），跟着上限缩

# ---- batch / parallelism --------------------------------------------------
# GBS = ROLLOUT_BATCH_SIZE × N_SAMPLES_PER_PROMPT = 8 × 8 = 64.
# Actor DP = actor_gpus / TP / CP = 4 / 1 / 2 = 2  →  64 % 2 = 0 ✓
: ${ROLLOUT_BATCH_SIZE:=8}
: ${N_SAMPLES_PER_PROMPT:=8}
: ${OVER_SAMPLING_BATCH_SIZE:=16}
: ${TENSOR_MODEL_PARALLEL_SIZE:=1}
# CP 保持 2（与 32k 配置一致，只改长度这一个变量）。CP=1 能把 actor DP 提到 4、
# 少一层通信，但那时 effective_limit = MAX_TOKENS_PER_GPU × 1 = 16000 < 16384，
# 单个满长样本放不下 —— 要一起把 MAX_TOKENS_PER_GPU 提到 20000 才行。留作后续调优。
: ${CONTEXT_PARALLEL_SIZE:=2}
: ${MAX_TOKENS_PER_GPU:=16000}         # × CP=2 = 32000，一个 16k 样本端到端放得下
: ${LOG_PROBS_CHUNK_SIZE:=2048}

# ---- SGLang KV cache 预算 —— 32k 卡死的直接原因就在这 ---------------------
# 池大小是**每引擎** SGLANG_MAX_TOTAL_TOKENS，而并发请求各自要预留自己的上下文：
#
#   32k 配置: 32 × 30720 = 983k  vs  池 524k  -> 超配 1.9 倍
#             前期样本短兜得住，一旦响应长度涨上来（RL 早期的典型现象）就开始回撤
#   16k 满并发: 32 × 16384 = 524288  -> 恰好顶满，任何碎片化都会立刻回撤
#   本配置:    24 × 16384 = 393k   vs  池 524k  -> 25% 余量 ✓
#
# 所以并发必须跟着长度一起降，只改长度不改并发仍然会抖动。
: ${SGLANG_MEM_FRACTION:=0.72}
: ${SGLANG_MAX_RUNNING_REQUESTS:=24}
: ${SGLANG_MAX_TOTAL_TOKENS:=524288}
: ${SGLANG_ATTENTION_BACKEND:=flashinfer}   # baremetal 覆盖会再设一次，这里写明预期值

# ---- schedule -------------------------------------------------------------
: ${NUM_ROLLOUT:=500}
: ${NUM_CRITIC_ONLY_STEPS:=30}
: ${EVAL_INTERVAL:=50}
: ${SAVE_INTERVAL:=25}
: ${HF_SAVE_INTERVAL:=25}

# ---- 继承配方旋钮 + LR + PPO clip + tracking 默认值 ------------------------
# GAE_LAMBDA_K / CRITIC_VALUE_BIAS_INIT / NUM_CRITIC_ONLY_STEPS / CRITIC_EXCLUDE_OLP /
# LR / PPO clip / dynamic sampling / partial rollout / TIS 全部来自这里，一个没动。
source "$(dirname "${BASH_SOURCE[0]}")/minicpm5-2b-math-128k.env"
