# JustRL2 — MiniCPM5-2B, 32k-context math RL on ONE node with 8 GPUs
# (4 actor + 4 critic, SGLang engines colocated on all 8).
#
# Not a paper-scale run — it exists so you can train the recipe end-to-end
# on a single 8×H100 node. The recipe knobs (GAE_LAMBDA_K, CRITIC_VALUE_BIAS_INIT,
# NUM_CRITIC_ONLY_STEPS, CRITIC_EXCLUDE_OLP, LR, PPO clip, dynamic sampling,
# partial rollout, TIS) are inherited from minicpm5-2b-math-128k.env at the bottom;
# only what changes for the 1-node/32k topology is set here.
#
#   HF_MODEL_DIR=$PWD/models/MiniCPM5-2B \
#   MEGATRON_MODEL_PATH=$PWD/models/MiniCPM5-2B-torch_dist \
#   bash justrl2/train.sh justrl2/configs/1node-8gpu-32k.env

# ---- experiment ------------------------------------------------------------
: ${EXP_TAG:=justrl2_minicpm5_2b_math32k_1node}

# ---- topology: 4 actor + 4 critic on the same node ------------------------
# train.sh's default (WORLD_SIZE/2) is a multi-node rule; on 1 node it needs
# the per-side GPU counts explicitly. Actor and critic world sizes must be
# equal — the actor↔critic NCCL groups are built rank-pairwise.
: ${GPUS_PER_NODE:=8}
: ${ACTOR_NUM_GPUS_PER_NODE:=4}
: ${CRITIC_NUM_GPUS_PER_NODE:=4}

# ---- 32k context budget ---------------------------------------------------
: ${ROLLOUT_MAX_PROMPT_LEN:=2048}
: ${ROLLOUT_MAX_RESPONSE_LEN:=30720}   # 32k - 2k prompt
: ${ROLLOUT_MAX_CONTEXT_LEN:=32768}
: ${OVERLONG_BUFFER_LEN:=6144}         # last 20% of response_len (DAPO soft overlong)

# ---- batch / parallelism --------------------------------------------------
# GBS = ROLLOUT_BATCH_SIZE × N_SAMPLES_PER_PROMPT = 8 × 8 = 64.
# Actor DP = actor_gpus / TP / CP = 4 / 1 / 2 = 2  →  64 % 2 = 0 ✓
: ${ROLLOUT_BATCH_SIZE:=8}
: ${N_SAMPLES_PER_PROMPT:=8}
: ${OVER_SAMPLING_BATCH_SIZE:=16}       # 2× oversampling, keep DAPO dynamic sampling honest
: ${TENSOR_MODEL_PARALLEL_SIZE:=1}
: ${CONTEXT_PARALLEL_SIZE:=2}           # reference used CP=4 for 128k; CP=2 tracks 32k

# One 32k sample sharded across CP=2 = 16k tokens/GPU. Log-probs pass sees
# MAX × CP = 32000 (enough for one 32k sample end-to-end).
: ${MAX_TOKENS_PER_GPU:=16000}
: ${LOG_PROBS_CHUNK_SIZE:=2048}

# ---- SGLang memory (colocated: 8 engines share the node with training) ----
# ~16 full-32k sequences per engine × 8 engines. Bump if you see KV-cache
# rejections; lower if training-side OOMs at update_weights.
: ${SGLANG_MEM_FRACTION:=0.72}
: ${SGLANG_MAX_RUNNING_REQUESTS:=32}
: ${SGLANG_MAX_TOTAL_TOKENS:=524288}
: ${SGLANG_ATTENTION_BACKEND:=fa3}

# ---- schedule -------------------------------------------------------------
: ${NUM_ROLLOUT:=500}
: ${NUM_CRITIC_ONLY_STEPS:=30}          # unchanged; critic must be usable before actor moves
: ${EVAL_INTERVAL:=50}                  # in-training eval; set to 1000 to disable and eval offline
: ${SAVE_INTERVAL:=25}
: ${HF_SAVE_INTERVAL:=25}               # HF export for offline eval / archival

# ---- inherit the recipe knobs + LR + PPO clip + tracking defaults ---------
# All the JustRL2-specific defaults live in the release config; every value
# above overrides its counterpart there via `: ${VAR:=default}` in the base file.
source "$(dirname "${BASH_SOURCE[0]}")/minicpm5-2b-math-128k.env"
