# JustRL2 — 1 node x 8 GPU, 16k, 裸机 cu129 栈（driver 535 / H20）
#
# 在 1node-8gpu-16k.env 之上，只覆盖「因为没有 Miles 镜像而必须改」的几处 ——
# 与 1node-8gpu-32k-baremetal.env 完全一样的三处覆盖，原因也一样。
#
# ⚠️ 关于 16k 本身不是配方复现这件事，见 1node-8gpu-16k.env 顶部的说明。
#
#   CONFIG=justrl2/configs/1node-8gpu-16k-baremetal.env bash run_train.sh
#
# 环境怎么搭的见 justrl2/setup/bare_metal_cu129.sh。

# ---- train.sh 会调 setup.sh，裸机上必须让它跳过 pip ------------------------
export SKIP_PIP_INSTALL=1

# ---- SGLang rollout 侧的 attention backend ----------------------------------
# 默认 fa3 在这台机器上不可用：Miles 自己的 Dockerfile 注明 cu129 没有 torch>=2.10 的
# sgl-flash-attn3 cubin，会退回运行时 JIT —— 而 driver 535 最高只能 JIT 到 PTX 8.2，
# CUDA 12.9 生成的是 PTX 8.8，会报 CUDA error 222。flashinfer 已实测通过。
: ${SGLANG_ATTENTION_BACKEND:=flashinfer}

# ---- 没有可用的 flash-attn ---------------------------------------------------
# torch 2.13 移除了 c10::impl::cow::materialize_cow_storage，而 torch 2.2~2.12 的
# 每一个 flash-attn wheel（含官方 Dao-AILab 的）都引用它，所以本栈上不装 flash-attn。
# TE 改走 cuDNN FusedAttention。两个变量必须同时设，否则仍会走 flash 路径。
: ${ATTENTION_BACKEND:=fused}
: ${NVTE_FUSED_ATTN:=1}

# ---- apex 的 fused_weight_gradient_mlp_cuda 同样 ABI 断裂 --------------------
: ${NO_GRAD_ACC_FUSION:=1}

: ${EXP_TAG:=justrl2_minicpm5_2b_math16k_1node_baremetal}

source "$(dirname "${BASH_SOURCE[0]}")/1node-8gpu-16k.env"
